   "source": [
    "lines = []\n",
    "with open('./filelists/wtimit_val.txt.cleaned', 'r+') as readFile:\n",
    "    lines = readFile.readlines()\n",
    "lines = [l.replace('/ssd_scratch/cvit/yash/converted_wavs/normal/', '/home/yash7/vF/valFiles/') for l in lines]\n",
    "lines = [l.replace('/wavs/', '/') for l in lines]\n",
    "with open('./filelists/wtimit_val2.txt.cleaned', 'w') as readFile:\n",
    "    readFile.writelines(''.join(lines))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [],
   "source": [
    "dataset = TextAudioSpeakerLoader(\"./test.txt.cleaned\", hps.data)\n",
    "collate_fn = TextAudioSpeakerCollate()\n",
